[Unit]
Description=Dispara a fila de emissao de boleto a cada 5 minutos
Documentation=https://github.com/upereira-jp/finaceiro

[Timer]
# A CADA 5 MINUTOS, e o numero nao e gosto: e o `base` da POLITICA de retentativa
# (`Q-AGENDA-02`, 300 s). O intervalo do timer e a GRANULARIDADE do retry - um
# timer de 15 minutos triplicaria calado uma base que ja tinha sido decidida, que
# e exatamente o tipo de default que a regra 10 proibe.
#
# Em :02 e nao em :00 para nao disputar o pool (teto 8) com o ciclo do CRM, que
# roda em :00, :15, :30 e :45.
OnCalendar=*:02/5
# Perdeu a hora porque a maquina estava desligada? Roda ao voltar, uma vez.
Persistent=true
# Nao arranca junto com o resto no boot: o servico principal e o banco primeiro.
OnBootSec=4min
AccuracySec=30s
Unit=financeiro-agenda-fila.service

[Install]
WantedBy=timers.target
