# financeiro-relatorio-mcp -- copie para .env (fora do git) e preencha.
# O servico le process.env direto (sem dotenv): quem carrega o arquivo e o
# systemd (EnvironmentFile) ou o node com --env-file.

# Porta e bind. 127.0.0.1 ate existir nginx+TLS na frente -- o bearer viaja
# no header, e a ficha do cliente tem dado pessoal.
PORT=8788
HOST=127.0.0.1

# Credencial de LEITURA do banco DO FINANCEIRO. Role `relatorio_ai`, criada
# por sql/01-fundacao.sql. NAO use postgres nem app_financeiro_login:
#   - postgres tem BYPASSRLS e escreve; o servico recusa subir (e bem).
#   - app_financeiro_login e a role do app; mistura-la aqui confunde a trilha
#     e amarra o relatorio ao ciclo de vida da aplicacao.
# Session pooler, porta 5432. O usuario no pooler e <role>.<ref-do-projeto>.
DATABASE_URL="postgresql://relatorio_ai.<REF>:<SENHA>@<HOST>.pooler.supabase.com:5432/postgres"

# CA do Postgres (prod-ca do painel Supabase). Sem ele o boot falha: TLS sem
# verificacao de certificado cifra mas nao autentica.
PG_CA_PATH=/etc/financeiro/supabase-prod-ca.crt

# Identidades. Uma entrada por consumidor. token: openssl rand -hex 32.
# tenants: uuids do financeiro, ou "*" para todos (resolvido no arranque).
# pii: libera ficha_cliente (dado pessoal). Terceiro entra com pii=false ate
# existir DPA -- rotear PII de cliente de outra empresa por LLM externa e
# decisao juridica cara de desfazer.
IDENTITIES='[{"token":"<hex64>","label":"dono","tenants":["*"],"pii":true}]'

# --- OAuth (connector do claude.ai web). Sem estas duas, so bearer estatico.
PUBLIC_BASE_URL="https://relatorio-financeiro.blackhaus.io"
OAUTH_LOGIN_PASSWORD="<senha-do-consentimento>"
OAUTH_STORE_PATH="/opt/financeiro/app/services/relatorio-mcp/oauth-store.json"
OAUTH_IDENTITY_LABEL="dono"
