generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model acesso_plataforma_log {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String              @db.Uuid
  usuario_id  String              @db.Uuid
  acao        String
  recurso     String
  ocorrido_em DateTime            @default(now()) @db.Timestamptz(6)
  xact_id     Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()"))
  tenant      tenant              @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario     usuario             @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenant_id, ocorrido_em(sort: Desc)], map: "acesso_plataforma_log_tenant_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cliente {
  id                          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                   String                @db.Uuid
  crm_lead_id                 String?               @db.Uuid
  nome                        String
  telefone                    String?
  email                       String?
  origem                      String?
  consumo_kwh                 Decimal?              @db.Decimal(14, 4)
  consumo_referencia_centavos Int?
  documento                   String?
  documento_tipo              documento_tipo?
  documento_validado          Boolean               @default(false)
  documento_origem            documento_origem?
  ativo                       Boolean               @default(true)
  criado_em                   DateTime              @default(now()) @db.Timestamptz(6)
  tenant                      tenant                @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cliente_estado_crm          cliente_estado_crm?
  contrato                    contrato[]
  unidade_consumidora         unidade_consumidora[]

  @@unique([tenant_id, crm_lead_id], map: "cliente_crm_lead_unico", where: raw("(crm_lead_id IS NOT NULL)"))
  @@unique([tenant_id, documento], map: "cliente_documento_unico", where: raw("(documento IS NOT NULL)"))
  @@unique([tenant_id, id], map: "cliente_id_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cliente_estado_crm {
  cliente_id       String    @id @db.Uuid
  tenant_id        String    @db.Uuid
  tem_rateio_ativo Boolean?
  tem_venda_ganha  Boolean?
  em_carteira      Boolean?
  sincronizado_em  DateTime? @db.Timestamptz(6)
  cliente          cliente   @relation(fields: [tenant_id, cliente_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "cec_cliente_fk")
  tenant           tenant    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, cliente_id], map: "cec_tenant_cliente_unico")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model conector_crm {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String          @unique @db.Uuid
  tipo               conector_tipo
  crm_tenant_id      String          @db.Uuid
  credencial_ref     String
  ativo              Boolean         @default(false)
  ultima_execucao_em DateTime?       @db.Timestamptz(6)
  ultimo_status      conector_status @default(nunca_executou)
  tenant             tenant          @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contrato {
  id                            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                     String                  @db.Uuid
  cliente_id                    String                  @db.Uuid
  unidade_consumidora_id        String                  @db.Uuid
  usina_id                      String                  @db.Uuid
  originador_id                 String?                 @db.Uuid
  data_fechamento               DateTime                @db.Date
  valor_referencia_centavos     Int
  valor_referencia_origem       valor_referencia_origem
  status                        status_contrato         @default(rascunho)
  faturas_cheias_pagas          Int                     @default(0)
  originador_tipo_no_fechamento originador_tipo?
  uc_vigente                    String?                 @default(dbgenerated("\nCASE\n    WHEN (status = ANY (ARRAY['ativo'::status_contrato, 'suspenso'::status_contrato])) THEN unidade_consumidora_id\n    ELSE NULL::uuid\nEND")) @db.Uuid
  cliente                       cliente                 @relation(fields: [tenant_id, cliente_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "contrato_cliente_fk")
  originador                    originador?             @relation(fields: [tenant_id, originador_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "contrato_originador_fk")
  tenant                        tenant                  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unidade_consumidora           unidade_consumidora     @relation(fields: [tenant_id, unidade_consumidora_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "contrato_uc_fk")
  usina                         usina                   @relation(fields: [tenant_id, usina_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "contrato_usina_fk")

  @@unique([tenant_id, uc_vigente], map: "contrato_vigente_unico_por_uc")
  @@unique([tenant_id, id], map: "contrato_id_tenant")
}

